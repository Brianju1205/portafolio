{
  "name": "briandev-portfolio",
  "functions": {
    "api/pract3/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/pract3/api/(documentos|pdf|resumen)\\.php",
      "dest": "/api/pract3/$1.php"
    },
    {
      "src": "/pract3/api/.*",
      "status": 404,
      "dest": "/404"
    },
    {
      "src": "/pract4",
      "status": 308,
      "headers": {
        "Location": "/pract4/"
      }
    },
    {
      "src": "/pract4/",
      "dest": "/pract4/plantilla/dist/index.html"
    },
    {
      "src": "/pract4/(assets|demo)/(.*)",
      "dest": "/pract4/plantilla/dist/$1/$2"
    },
    {
      "src": "/pract4/favicon.ico",
      "dest": "/pract4/plantilla/dist/favicon.ico"
    }
  ]
}
